# syntax=docker/dockerfile:1
# Both server variants consume the exact portable wheel produced from source S.
# Override BASE_IMAGE with the pinned generic-server index for Podman.
ARG BASE_IMAGE=ghcr.io/omnigent-ai/omnigent-server-kubernetes:v0.23.0@sha256:3ae833b9d9bd57fa29bf9c759c94b1bfe73d342b6b16792f65a7e014323bb10d
FROM ${BASE_IMAGE}
ARG SOURCE_COMMIT
ARG WHEEL_SHA256
ARG IMAGE_VARIANT=server-kubernetes
ARG BASE_IMAGE
LABEL org.opencontainers.image.source="https://github.com/WOOWTECH/omnigent" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      io.woowtech.omnigent.wheel-sha256="${WHEEL_SHA256}" \
      io.woowtech.omnigent.base-image="${BASE_IMAGE}" \
      io.woowtech.omnigent.variant="${IMAGE_VARIANT}"

COPY deploy/docker/woowtech-runtime-security.sh deploy/docker/woowtech-pip-security.txt /build/
RUN sh /build/woowtech-runtime-security.sh

# 換檔前先確認 image 內的原檔就是 git tag v0.23.0 的版本，overlay 才只帶這次的 diff。
# （2026-11-23 從 v0.23.0 的 server、server-kubernetes amd64 image layer 實算，兩者相同，也等於 git tag 的檔案。）
RUN printf '%s\n' \
      'ed69910bc50793e9330da7644937c6784b45970575dd48d8eff1c64c54ef127a  /build/omnigent/server/routes/_sessions/orchestration.py' \
      'f54ea4afe39fbd689af39198657b3068436224cc84789499a60cc6e22da8c334  /build/omnigent/server/app.py' \
      '9c9f77f4f01924a2563379660c8e1da777b4f46cd2e13fc6e6e99176bb08ba81  /build/omnigent/server/routes/hosts.py' \
      '3cbeed8fecadab6f9bfb09ae5b731ae7ed28275d1f694249c7aae54e7065fe8f  /build/omnigent/server/routes/_gzip_route.py' \
      'a342be4bf401feb8d3bc2fa4a6a7cdba3c09292faad696c70007cfaa1ee5689c  /build/omnigent/stores/host_store.py' \
    | sha256sum -c -
RUN test -f /build/omnigent/server/static/web-ui/index.html

# A named context prevents a Docker build from silently rebuilding another wheel/UI.
COPY --from=mcp-artifact / /opt/woow-artifact/
COPY scripts/woowtech_mcp_artifact.py /opt/woow-artifact/verify.py
RUN test -n "$SOURCE_COMMIT" && test -n "$WHEEL_SHA256" \
 && printf '%s  %s\n' "$WHEEL_SHA256" /opt/woow-artifact/omnigent-0.23.0-py3-none-any.whl | sha256sum -c - \
 && /opt/venv/bin/python /opt/woow-artifact/verify.py verify \
      --artifact /opt/woow-artifact --source-commit "$SOURCE_COMMIT" \
 && /opt/venv/bin/python -m pip install --no-deps --no-index --force-reinstall \
      /opt/woow-artifact/omnigent-0.23.0-py3-none-any.whl \
 && rm -rf /build/omnigent /build/omnigent.egg-info \
 && /opt/venv/bin/python /opt/woow-artifact/verify.py runtime \
      --artifact /opt/woow-artifact --source-commit "$SOURCE_COMMIT" --debian-security \
      --image-variant "$IMAGE_VARIANT"
